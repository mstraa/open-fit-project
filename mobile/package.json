{
  "name": "openfit-mobile",
  "version": "0.4.0",
  "private": true,
  "description": "Open Fit Android app — Capacitor wrapper around the React web UI, plus the Gadgetbridge bridge (reads Gadgetbridge's exported SQLite DB → relays wellness/activities to the self-hosted ofit-api).",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "build:web": "cd ../web && npm run build",
    "sync": "npm run build:web && cap sync",
    "open": "cap open android",
    "run:android": "npm run sync && cap run android",
    "deploy": "../scripts/deploy-android.sh",
    "deploy:fast": "../scripts/deploy-android.sh --fast",
    "app:clean": "../scripts/adb-clean.sh",
    "app:reinstall": "../scripts/adb-clean.sh --latest"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^6.1.0",
    "@capacitor-community/sqlite": "^6.0.2",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/share": "^6.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "typescript": "^6.0.3"
  }
}
