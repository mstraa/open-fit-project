# Open Fit — deployment environment
# Copy to `.env` (same directory) and edit. `.env` is gitignored.
#
#   cp docker/.env.example docker/.env
#
# Both compose files read this file automatically (it sits next to them).

# --- shared (both tiers) -----------------------------------------------------

# Single-user auth token for the API. Generate one, e.g.:
#   openssl rand -hex 32
# Leave empty to let the first-run wizard set it interactively.
OFIT_TOKEN=

# Log filter for the Rust backend (tracing EnvFilter syntax).
RUST_LOG=info

# --- simple tier (SQLite) ----------------------------------------------------
# docker-compose.simple.yml uses this. The DB lives on the `ofit-data` volume,
# mounted at /data inside the container.
DATABASE_URL=sqlite:///data/ofit.db?mode=rwc

# --- full tier (Postgres / TimescaleDB) --------------------------------------
# docker-compose.full.yml uses these. The api service's DATABASE_URL is built
# from POSTGRES_* and points at the `db` service, so usually only edit the
# password here.
POSTGRES_USER=ofit
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=ofit

# Connection string the api uses to reach the `db` service on the compose
# network. Keep host=db / port=5432 unless you change the service definition.
POSTGRES_DATABASE_URL=postgres://ofit:change-me-please@db:5432/ofit
